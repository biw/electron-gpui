{
  "name": "electron-gpui-unplugin",
  "version": "0.3.0",
  "description": "Vite/Rollup/Rolldown/webpack/esbuild plugin that builds and bundles your electron-gpui addon",
  "keywords": [
    "electron",
    "gpui",
    "unplugin",
    "vite",
    "rollup",
    "rolldown",
    "webpack",
    "esbuild",
    "tsdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biw/electron-gpui.git",
    "directory": "packages/electron-gpui-unplugin"
  },
  "homepage": "https://github.com/biw/electron-gpui#readme",
  "bugs": "https://github.com/biw/electron-gpui/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.mts",
        "default": "./dist/rollup.mjs"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./rolldown": {
      "import": {
        "types": "./dist/rolldown.d.mts",
        "default": "./dist/rolldown.mjs"
      },
      "require": {
        "types": "./dist/rolldown.d.cts",
        "default": "./dist/rolldown.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.mts",
        "default": "./dist/esbuild.mjs"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "prepack": "node ../../scripts/package-files.mjs && pnpm build"
  },
  "peerDependencies": {
    "electron-gpui": "^0.3.0"
  },
  "dependencies": {
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "electron-gpui": "workspace:*",
    "esbuild": "^0.28",
    "rolldown": "^1.2",
    "rollup": "^4.64",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webpack": "^5.111"
  }
}
